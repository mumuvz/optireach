# Surfaced — environment configuration
# Copy to .env and fill in values. NEVER commit .env. Only VITE_* variables reach the browser bundle;
# every other variable is server-only (API, worker, seed scripts).
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   # SESSION_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"      # ENCRYPTION_KEY

# ---------- Core ----------
NODE_ENV=development
APP_NAME=Surfaced
# Public URL of the web app (used in emails, OAuth return URLs, sitemap, canonical links).
APP_URL=http://localhost:5173
# Public base URL of the API (used to build the OAuth callback URL).
API_URL=http://localhost:4000
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Set to the number of trusted reverse-proxy hops (e.g. 1) in production so client IPs are correct.
TRUST_PROXY=false
LOG_LEVEL=info
# pretty | json (defaults: pretty in development, json in production/test)
LOG_FORMAT=
# Serve the built web app (apps/web/dist) from the API process (single-origin deployments).
SERVE_WEB_DIST=false

# ---------- Database (MySQL 8+) ----------
# Percent-encode special characters in credentials (e.g. "@" becomes %40).
DATABASE_URL=mysql://surfaced:change-me@127.0.0.1:3306/surfaced
# Used only by automated tests. The database name MUST end with "_test".
TEST_DATABASE_URL=mysql://surfaced:change-me@127.0.0.1:3306/surfaced_test
# Used only by the Playwright end-to-end suite.
E2E_DATABASE_URL=mysql://surfaced:change-me@127.0.0.1:3306/surfaced_e2e
DATABASE_CONNECTION_LIMIT=10
# MySQL 8 caching_sha2_password over non-TLS connections needs RSA key retrieval. Local development only;
# in production use TLS (DATABASE_SSL=true) and leave this false.
DATABASE_ALLOW_PUBLIC_KEY_RETRIEVAL=false
DATABASE_SSL=false

# ---------- Redis / BullMQ ----------
REDIS_URL=redis://127.0.0.1:6379
# Key prefix for queues (lets several environments share one Redis safely).
QUEUE_PREFIX=surfaced

# ---------- Auth & security ----------
# At least 32 characters. Signs CSRF tokens and keys IP hashing.
SESSION_SECRET=
# 32 random bytes, base64-encoded. Encrypts OAuth tokens at rest (AES-256-GCM). Rotating it invalidates stored tokens.
ENCRYPTION_KEY=
SESSION_TTL_DAYS=30
# Optional cookie domain, e.g. ".example.com" when the API is on a subdomain of the app.
COOKIE_DOMAIN=
# auto = Secure cookies in production only. Production rejects "false".
COOKIE_SECURE=auto

# ---------- AI providers ----------
# openai | gemini | dev | none. The content/analysis model for keyword ideas, content briefs, competitor gap
# extraction, trend insights and AEO analysis. "gemini" uses GEMINI_API_KEY + GEMINI_MODEL below. "dev" returns
# clearly labeled template output (not AI) and is refused in production.
LLM_PROVIDER=dev
OPENAI_API_KEY=
# Optional, for OpenAI-compatible gateways.
OPENAI_BASE_URL=
# Model for content generation (default gpt-5.4-mini).
OPENAI_MODEL=
# Model for AI visibility checks with web search (default gpt-5.4-mini; OpenAI recommends gpt-5.5 for best quality).
OPENAI_VISIBILITY_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=6000
# Perplexity Agent API with web search (enables the "perplexity_sonar" visibility provider; the key name is
# historical). PERPLEXITY_MODEL is the Agent API preset; the default "sonar" maps to the "fast" preset.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar
# Gemini (Google Generative Language API). Used as the content/analysis model when LLM_PROVIDER=gemini, and for the
# "gemini_model_knowledge" visibility provider (answers WITHOUT Google Search grounding — Google's terms do not allow
# storing grounded answers; it is not the Gemini app and not a live search). GEMINI_MODEL is a currently supported
# model id for the account.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
# Google Maps Platform key with the Places API (New) enabled: "Fill from a Google link" fills a location's address,
# phone, hours, category and map position (server-side only; never put it in a VITE_ variable). Without it, only the
# name and position carried by the link itself are filled. Billed per request by Google after its monthly free usage.
GOOGLE_MAPS_API_KEY=
# Address lookup for "Find from address": OpenStreetMap Nominatim (light use only, one request per second, results
# cached), or none. Point GEOCODER_URL at your own Nominatim for heavier use.
GEOCODER=nominatim
GEOCODER_URL=https://nominatim.openstreetmap.org
# Enables the labeled "Demo fixtures" visibility provider. Refused in production.
AI_DEMO_MODE=true
# ---------- Keyword trends (Google Trends) ----------
# Providers the server allows: csv, pytrends, dataforseo, google_trends_api, fixture (fixture = generated development
# data; refused in production). Leaving one out hides it everywhere. CSV import needs nothing else.
TRENDS_PROVIDERS=csv,pytrends,dataforseo,google_trends_api
# Optional, free, EXPERIMENTAL: the pytrends service (services/pytrends). pytrends is an unofficial, archived library
# that reads Google Trends' website endpoints; Google may change or block them. Set up with "npm run trends:setup",
# run with "npm run trends:start", then set the URL below. A token is required when it listens beyond localhost.
PYTRENDS_SERVICE_URL=
PYTRENDS_SERVICE_TOKEN=
PYTRENDS_TIMEOUT_MS=120000
# Read by the pytrends service itself: seconds between requests to Google, pause after a 429, in-memory cache.
PYTRENDS_MIN_INTERVAL_SECONDS=8
PYTRENDS_COOLDOWN_SECONDS=900
PYTRENDS_CACHE_SECONDS=3600
# Optional, paid: licensed Google Trends data through DataForSEO (https://app.dataforseo.com/api-access).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Official Google Trends API (closed alpha, by application). Not implemented until access is granted and tested.
GOOGLE_TRENDS_API_KEY=
GOOGLE_TRENDS_API_ALPHA_ACCESS=false
# Hours fetched data is reused, by provider and data type ("default=12,regions=24,pytrends.interest=6").
TRENDS_CACHE_TTL_HOURS=default=12
# Live lookups per workspace per 24 hours (reused cached data and CSV imports do not count).
TRENDS_LIVE_REPORTS_PER_WORKSPACE_PER_DAY=30

# ---------- Local SEO (rank grids) ----------
# Google offers no API for Maps or local-pack rankings, and there is no permitted way to automatically collect
# Google's actual Maps ranking order without a licensed data provider or anti-bot evasion. Options for local rank
# collection:
#   "none"   — manual observations only: a person searches Google Maps and records the exact order shown (that is
#              Google's real order, labeled as a manual observation).
#   "osm"    — free, permitted OpenStreetMap discovery (Overpass + Nominatim): real businesses mapped near each grid
#              point, ordered by DISTANCE. This is competitor discovery, NOT a Google Maps ranking, with no ratings
#              or review counts; coverage depends on what the OSM community has mapped. Respect OSM fair-use.
#   "custom" — your own operator-hosted collection service (CUSTOM_SERP_URL). The app POSTs each grid point and
#              stores the results in the order your service returns them, as observed positions, without reordering.
#              You build and are responsible for that service and the compliance of its collection method.
SERP_PROVIDER=none
# Overpass endpoint used by SERP_PROVIDER=osm (point OVERPASS_URL at your own instance for heavier use).
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Your own collection service for SERP_PROVIDER=custom. It receives POST { query, latitude, longitude, surface,
# language, device, depth, country } and must return { results: [ ... ], collectedAt?, continuous?, observationType? }.
# Each result: { title, rank?, placeId?, domain?, url?, category?, rating?, reviewCount?, address?, phone?,
# latitude?, longitude?, sponsored?, batch?, sourcePosition? }. Results are stored in the exact order given.
#   sponsored      — true for a paid/ad listing (flagged separately from organic; never counted as an organic win).
#   batch          — continuation batch/page number (1 for the first view); results are grouped and kept in order.
#   sourcePosition — position within its batch as your service saw it (defaults to the order within the batch).
#   continuous     — set true ONLY when the batches form one uninterrupted sequence; then a cumulative position is
#                    assigned across batches. Omit it and no continuous ranking is invented across batches.
#   observationType — observed_search_position | discovery_order | estimated_visibility (how the order was obtained).
CUSTOM_SERP_URL=
CUSTOM_SERP_TOKEN=
# In production a localhost CUSTOM_SERP_URL is refused (that is the demo mock pattern, scripts/mock-local-scraper.mjs,
# which returns fake data). Set this true only when your real collection service genuinely runs on the same host.
CUSTOM_SERP_ALLOW_LOOPBACK=false
# Development and tests only: generated rank results, labeled as not real Google data. Refused in production.
LOCAL_RANK_FIXTURES=false
# Google Programmable Search / Custom Search JSON API: real Google ORGANIC web results for the ORGANIC rank surface,
# free up to 100 searches/day. This is NOT the Maps local pack (no free source provides that) and is country-level,
# not per coordinate. Get a free API key at console.cloud.google.com (enable "Custom Search API") and an engine ID
# (cx) at programmablesearchengine.google.com (set it to search the whole web). Both values enable it.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# ---------- Keyword data ----------
# Licensed keyword-metrics providers are not bundled. "none" means search volume, difficulty and CPC are never shown.
KEYWORD_DATA_PROVIDER=none

# ---------- Google OAuth (Search Console) ----------
# Create an OAuth client (type "Web application") in Google Cloud, enable the Search Console API, and add
# the redirect URI below to "Authorized redirect URIs". See docs/integrations.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback

# ---------- Billing ----------
# none | dev | stripe | razorpay. "dev" lets owners switch plans locally with NO payment and is refused in production.
BILLING_PROVIDER=dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Email ----------
# console = write .eml files to var/mail (status LOGGED_LOCALLY, never "sent"). smtp = deliver via SMTP.
EMAIL_PROVIDER=console
EMAIL_FROM=Surfaced <no-reply@example.com>
# Recipient for contact-form submissions.
SALES_EMAIL=hello@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ---------- Storage ----------
# Generated reports are stored here (relative to the repository root unless absolute).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/storage

# ---------- Crawler ----------
CRAWLER_USER_AGENT=SurfacedBot/0.1 (+https://example.com/bot)
# Server-wide page cap per crawl. 0 = no cap: audits crawl every page reachable through links and sitemaps.
CRAWLER_MAX_PAGES_HARD_LIMIT=0
CRAWLER_CONCURRENCY=4
# Pages checked per site in an SEO comparison (your site and each competitor alike; 20-5000).
COMPETITOR_CRAWL_MAX_PAGES=250
CRAWLER_REQUEST_TIMEOUT_MS=15000
CRAWLER_MAX_BODY_BYTES=5242880
# Development/test only: host:port pairs (port may be "*") the crawler may reach despite SSRF rules,
# e.g. 127.0.0.1:4555 for the local E2E fixture site. Ignored when NODE_ENV=production.
CRAWLER_DEV_ALLOWLIST=

# ---------- PDF rendering ----------
# chromium = print reports with headless Chromium (install with `npx playwright install chromium`); none = HTML only.
PDF_RENDERER=chromium
PDF_CHROMIUM_EXECUTABLE_PATH=

# ---------- Frontend (public; baked into the client bundle at build time) ----------
# API base path or URL. "/api/v1" works with the Vite dev proxy and single-origin deployments.
VITE_API_URL=/api/v1
# Canonical public site URL used for prerendered metadata, sitemap.xml and robots.txt.
VITE_SITE_URL=http://localhost:5173
# Contact address shown on the website (footer, contact and legal pages).
VITE_CONTACT_EMAIL=hello@surfaced.example
# Map tiles for the rank grid. Empty uses OpenStreetMap's public tiles, which allow light use only (see
# https://operations.osmfoundation.org/policies/tiles/); set a tile provider for production, with its attribution.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=

# ---------- Development seed (refused in production) ----------
# Password for the seeded admin and demo accounts (at least 10 characters). Never reuse a real password.
SEED_DEMO_PASSWORD=change-me-demo-password
# Optional account addresses (defaults: admin@surfaced.test and demo@surfaced.test; .test addresses receive no email).
SEED_ADMIN_EMAIL=
SEED_DEMO_EMAIL=
