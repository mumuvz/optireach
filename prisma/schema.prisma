// Surfaced — Prisma schema for MySQL 8+.
// Conventions:
//   * String primary keys use CUIDs (non-sequential, not guessable).
//   * Long URLs are stored with a SHA-256 hash column (`*Hash`) used for indexes/uniqueness,
//     because InnoDB cannot index a full VARCHAR(2048) utf8mb4 column.
//   * All DateTime values are written in UTC by Prisma (DATETIME(3)).
//   * Money uses DECIMAL(10,2). JSON columns are used only for small, schema-validated
//     structures (settings snapshots, evidence, code lists) — never for relational data.
//   * Every tenant-owned row is reachable from a Workspace through foreign keys.

generator client {
  provider            = "prisma-client"
  output              = "../packages/core/src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "mysql"
}

